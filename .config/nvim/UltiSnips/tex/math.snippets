snippet addsvg "add figure with inkscape" bA
\begin{figure}[H]
	\centering
	\includesvg[width=0.8\textwidth]{figures/$1}
	\caption{$2}
	\label{$3}
\end{figure}
endsnippet

snippet addfig "add figure with inkscape" bA
\begin{figure}[H]
	\centering
	\includegraphics[width=0.8\textwidth]{figures/$1}
	\caption{$2}
	\label{$3}
\end{figure}$0
endsnippet

snippet plot "plot functions in a non-float environment" bA
\begin{minipage}{\linewidth}
\centering
	\begin{tikzpicture}
		\begin{axis}[
			axis y line = center,
			axis x line = middle,
			xmin=$1,xmax=$2,
			ytick=\empty,xtick=\empty]
		]
		\addplot[mark=none]{$3};
		% \node[label={180:{$B(0,b)$}},circle,fill,inner sep=2pt] at (axis cs:0,3) {};
	\end{axis}
	\end{tikzpicture}
\end{minipage}$0
endsnippet

